# Copia este archivo a .env.local y completa los valores. NUNCA subas .env.local ni pegues estas claves en el chat.

# Modo local sin cuenta de Supabase (base PGlite en .local/, solo fuera de producción).
# Descomenta esta línea y deja el resto vacío para desarrollar sin Supabase:
# DEMO_BD=local

# Supabase (Project Settings > API): la URL y la anon key. SOLO del servidor, a propósito SIN «NEXT_PUBLIC_»: el navegador
# nunca habla con Supabase. Así nadie puede llamar la API directo con la llave (ni pedir los avisos push del personal ni
# cambiar la contraseña de la cuenta de la demo). Una prueba (llaves-solo-servidor.test.ts) lo vigila.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Avisos push al personal cuando un cliente autoriza o rechaza un hallazgo. Se generan UNA vez con `npm run vapid`; la
# llave privada es solo del servidor. Sin las tres, la app funciona igual y los avisos no se mandan.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# «Probar la demo» en /entrar (fase 7). Dos usuarios creados en Supabase (Authentication > Users, "Auto Confirm User") y
# dados de alta con: select public.fn_provisionar_demo('correo-gerente', 'correo-jefe');
# Sin estas variables los botones no aparecen. Nunca uses aquí cuentas de un taller de verdad.
# DEMO_EMAIL=
# DEMO_PASSWORD=
# DEMO_JEFE_EMAIL=
# DEMO_JEFE_PASSWORD=
